---
/**
 * Barra de navegação global. sectionPrefix: "root" = âncoras #secção (página longa na raiz);
 * "sub" = /#secção para saltar à home a partir de outras rotas.
 */
export interface Props {
  logoHref: string;
  sectionPrefix: "root" | "sub";
  active?: "sobre" | "simulador";
  cta?: "simular" | "comecar" | "none";
  showSimuladorInNav?: boolean;
  "aria-label"?: string;
  logoAriaLabel?: string;
}

const {
  logoHref,
  sectionPrefix,
  active,
  cta = "simular",
  showSimuladorInNav = false,
  "aria-label": navAria,
  logoAriaLabel,
} = Astro.props;

const p = sectionPrefix === "root" ? "#" : "/#";
const h = (id: string) => `${p}${id}`;
const contactoHref = sectionPrefix === "root" ? "#contacto" : "/#contacto";
const sobreStyle =
  active === "sobre" ? "color: var(--gold); font-weight: 600;" : undefined;
const simStyle =
  active === "simulador"
    ? "color: var(--gold); font-weight: 600;"
    : undefined;
---

<nav aria-label={navAria}>
  <a href={logoHref} class="nav-logo" aria-label={logoAriaLabel}
    >ON<span>DIGITAL</span></a
  >
  <ul class="nav-links">
    <li><a href={h("servicos")}>Serviços</a></li>
    <li><a href={h("processo")}>Processo</a></li>
    <li><a href={h("precos")}>Preços</a></li>
    <li><a href={h("contacto")}>Contacto</a></li>
    <li>
      <a href="/sobre" style={sobreStyle}>Sobre Nós</a>
    </li>
    {
      showSimuladorInNav && (
        <li>
          <a href="/simulador" style={simStyle}>
            Simulador
          </a>
        </li>
      )
    }
  </ul>
  {
    cta === "simular" && (
      <a href="/simulador" class="nav-cta">
        Simular Projeto
      </a>
    )
  }
  {
    cta === "comecar" && (
      <a href={contactoHref} class="nav-cta">
        Começar Projeto
      </a>
    )
  }
</nav>
