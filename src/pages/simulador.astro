---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Simulador — ON DIGITAL"
  sectionPrefix="sub"
  navLogoHref="/"
  cta="none"
>
  <section class="simulator-hero">
    <div class="simulator-hero-content">
      <div class="section-label">
        <span class="num">01</span> Experiência Gratuita
      </div>
      <h1 class="simulator-title">
        Simulador de <span>Presença Digital</span>
      </h1>
      <p class="simulator-desc">
        Não imagine o seu sucesso, veja-o. Preencha os detalhes abaixo e a nossa
        equipa de design criará uma pré-visualização exclusiva do seu futuro
        website, sem qualquer compromisso.
      </p>
    </div>
  </section>

  <section class="simulator-info">
    <div class="info-grid">
      <div class="info-item">
        <div class="info-icon">01</div>
        <h3 class="info-title">Partilhe a sua Visão</h3>
        <p class="info-text">
          Diga-nos o nome do seu negócio, o que faz e o estilo que prefere.
          Quanto mais detalhes, mais precisa será a nossa proposta.
        </p>
      </div>
      <div class="info-item">
        <div class="info-icon">02</div>
        <h3 class="info-title">Design à Medida</h3>
        <p class="info-text">
          Os nossos designers analisam o seu ramo e criam um conceito visual que
          alia estética premium a funcionalidade estratégica.
        </p>
      </div>
      <div class="info-item">
        <div class="info-icon">03</div>
        <h3 class="info-title">Receba a Proposta</h3>
        <p class="info-text">
          Em menos de 4, enviamos-lhe uma maquete digital para
          que possa ver exatamente como a sua marca brilhará online.
        </p>
      </div>
    </div>
  </section>

  <section class="simulator-section" id="form-anchor">
    <div class="simulator-container">
      <div class="form-header">
        <h2 class="form-title">Inicie a sua Transformação</h2>
        <p class="form-subtitle">
          Preencha o formulário para receber a sua simulação gratuita.
        </p>
      </div>

      <!-- FORMULÁRIO -->
      <form class="simulator-form" id="sim-form-page" novalidate>
        <div class="form-row">
          <div class="form-group">
            <label for="sim-nome">Nome do Negócio</label>
            <input
              id="sim-nome"
              name="nome"
              type="text"
              placeholder="Ex: Café Central"
              required
            />
          </div>
          <div class="form-group">
            <label for="sim-ramo">Ramo de Atividade</label>
            <input
              id="sim-ramo"
              name="ramo"
              type="text"
              placeholder="Ex: Restauração, Imobiliária..."
              required
            />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="sim-cores">Cores de Preferência</label>
            <input
              id="sim-cores"
              name="cores"
              type="text"
              placeholder="Ex: Azul Marinho e Dourado"
            />
          </div>
          <div class="form-group">
            <label for="sim-inspiracao">Website de Inspiração (Opcional)</label>
            <input
              id="sim-inspiracao"
              name="inspiracao"
              type="url"
              placeholder="https://exemplo.com"
            />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="sim-email">O seu E-mail</label>
            <input
              id="sim-email"
              name="email"
              type="email"
              placeholder="nome@empresa.com"
              required
            />
          </div>
          <div class="form-group">
            <label for="sim-telefone">Telemóvel / WhatsApp</label>
            <input
              id="sim-telefone"
              name="telefone"
              type="tel"
              placeholder="+351 9xx xxx xxx"
              required
            />
          </div>
        </div>

        <div class="form-group">
          <label for="sim-mensagem">Mensagem ou Observações Adicionais</label>
          <textarea
            id="sim-mensagem"
            name="mensagem"
            placeholder="Conte-nos um pouco mais sobre os seus objetivos..."
          ></textarea>
        </div>

        <button type="submit" class="btn-simulate" id="sim-submit-btn">
          <span id="sim-btn-text">Solicitar Pré-visualização Gratuita</span>
          <span id="sim-btn-loading" style="display:none;">A enviar...</span>
        </button>
        <p class="form-note">
          Ao clicar, concorda em ser contactado pela ON DIGITAL para fins de
          apresentação da proposta.
        </p>
      </form>

      <!-- SUCESSO -->
      <div
        id="sim-success"
        style="display:none; text-align:center; padding: 60px 20px;"
      >
        <svg
          width="64"
          height="64"
          viewBox="0 0 64 64"
          fill="none"
          style="margin: 0 auto 24px; display:block;"
        >
          <circle cx="32" cy="32" r="31" stroke="#C9A84C" stroke-width="2"
          ></circle>
          <path
            d="M18 32L28 42L46 22"
            stroke="#C9A84C"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <h3
          style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; color: #C9A84C; margin: 0 0 12px;"
        >
          Pedido Recebido!
        </h3>
        <p
          style="color: #9E9E8E; max-width: 400px; margin: 0 auto; line-height: 1.7;"
        >
          A nossa equipa analisará o seu pedido e entrará em contacto em menos
          de <strong style="color:#F5F2EC;">48 horas</strong>.
        </p>
      </div>

      <!-- ERRO -->
      <div
        id="sim-error"
        style="display:none; text-align:center; padding: 20px; background: rgba(180,40,40,0.1); border: 1px solid rgba(180,40,40,0.3); border-radius: 8px; margin-top: 20px;"
      >
        <p style="color: #e07070; margin: 0;">
          Ocorreu um erro ao enviar. Por favor tente novamente ou contacte-nos
          diretamente pelo WhatsApp.
        </p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      // ⚠️ SUBSTITUI ESTA URL PELA URL DO TEU GOOGLE APPS SCRIPT
      const APPS_SCRIPT_URL =
        "https://script.google.com/macros/s/AKfycbzK9wNRYKQ2jQcwq9D-BcNS04BYVGrErRe_5W-Sox6irmoWhVcFDN80OYIjLkgofb7eyg/exec";

      const form = document.getElementById("sim-form-page");
      const submitBtn = document.getElementById("sim-submit-btn");
      const btnText = document.getElementById("sim-btn-text");
      const btnLoading = document.getElementById("sim-btn-loading");
      const successDiv = document.getElementById("sim-success");
      const errorDiv = document.getElementById("sim-error");

      if (!form) return;

      form.addEventListener("submit", async function (e) {
        e.preventDefault();

        // Esconder erro anterior
        errorDiv.style.display = "none";

        // Estado de loading
        submitBtn.disabled = true;
        btnText.style.display = "none";
        btnLoading.style.display = "inline";

        // Recolher dados do formulário
        const formData = new FormData(form);
        const payload = {
          nome: formData.get("nome") || "",
          ramo: formData.get("ramo") || "",
          cores: formData.get("cores") || "",
          inspiracao: formData.get("inspiracao") || "",
          email: formData.get("email") || "",
          telefone: formData.get("telefone") || "",
          mensagem: formData.get("mensagem") || "",
        };

        try {
          // Enviar via GET com parâmetros na URL
          // (o browser converte POST→GET ao seguir o redirect do Google)
          const params = new URLSearchParams(payload);
          await fetch(`${APPS_SCRIPT_URL}?${params.toString()}`, {
            method: "GET",
            mode: "no-cors",
          });

          // Assumir sucesso
          form.style.display = "none";
          successDiv.style.display = "block";
        } catch (err) {
          console.error("Erro ao enviar formulário:", err);
          errorDiv.style.display = "block";
          submitBtn.disabled = false;
          btnText.style.display = "inline";
          btnLoading.style.display = "none";
        }
      });
    })();
  </script>

  <section class="simulator-benefits">
    <div class="benefits-inner">
      <h2 class="benefits-title">O que vai receber?</h2>
      <div class="benefits-list">
        <div class="benefit">
          <svg class="benefit-check" viewBox="0 0 24 24">
            <path d="M20 6L9 17L4 12"></path>
          </svg>
          <span>Conceito Visual da Página Principal</span>
        </div>
        <div class="benefit">
          <svg class="benefit-check" viewBox="0 0 24 24">
            <path d="M20 6L9 17L4 12"></path>
          </svg>
          <span>Paleta de Cores e Tipografia Sugerida</span>
        </div>
        <div class="benefit">
          <svg class="benefit-check" viewBox="0 0 24 24">
            <path d="M20 6L9 17L4 12"></path>
          </svg>
          <span>Análise Preliminar de UX/UI</span>
        </div>
        <div class="benefit">
          <svg class="benefit-check" viewBox="0 0 24 24">
            <path d="M20 6L9 17L4 12"></path>
          </svg>
          <span>Orçamento Detalhado sem Compromisso</span>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
