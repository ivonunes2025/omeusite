---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Portfólio — Nossos Projetos de Sucesso"
  description="Explore os websites e experiências digitais que criámos para os nossos clientes. Design premium, performance e resultados."
  sectionPrefix="sub"
  navLogoHref="/"
  activeNav="portfolio"
  cta="simular"
>
  <section class="portfolio-hero">
    <div class="portfolio-hero-content">
      <div class="section-label">O Nosso Trabalho</div>
      <h1 class="portfolio-title">Projetos que <span>Inspiram</span></h1>
      <p class="portfolio-desc">
        Transformamos visões em experiências digitais de elite, onde cada
        detalhe é desenhado para projetar autoridade e exclusividade no mercado.
      </p>
    </div>
  </section>

  <section class="portfolio-grid-section">
    <div class="portfolio-grid">
      <article class="project-card">
        <div class="project-image">
          <img src="/images/portfolio/luxe.png" alt="Website Luxe Boutique" />
          <div class="project-overlay">
            <a href="#" class="project-link">Ver Website</a>
          </div>
        </div>
        <div class="project-info">
          <div class="project-category">Moda & Luxo</div>
          <h2 class="project-name">Luxe Boutique</h2>
          <p class="project-description">
            Uma experiência de e-commerce minimalista e sofisticada para uma
            marca de alta costura.
          </p>
        </div>
      </article>

      <article class="project-card">
        <div class="project-image">
          <img src="/images/portfolio/nova.png" alt="Website Nova Real Estate" />
          <div class="project-overlay">
            <a href="#" class="project-link">Ver Website</a>
          </div>
        </div>
        <div class="project-info">
          <div class="project-category">Imobiliária</div>
          <h2 class="project-name">Nova Real Estate</h2>
          <p class="project-description">
            Portal imobiliário focado em propriedades de alto padrão com
            interface moderna.
          </p>
        </div>
      </article>

      <article class="project-card">
        <div class="project-image">
          <img src="/images/portfolio/sabor.png" alt="Website Sabor & Arte" />
          <div class="project-overlay">
            <a href="#" class="project-link">Ver Website</a>
          </div>
        </div>
        <div class="project-info">
          <div class="project-category">Gastronomia</div>
          <h2 class="project-name">Sabor & Arte</h2>
          <p class="project-description">
            Website imersivo para um restaurante fine dining, destacando a
            experiência culinária.
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="portfolio-cta">
    <div class="portfolio-cta-inner">
      <h2 class="cta-title">Pronto para o <span>seu sucesso?</span></h2>
      <p class="cta-desc">
        O seu projeto pode ser o próximo nesta lista. Vamos construir algo
        inesquecível juntos?
      </p>
      <a href="/simulador" class="btn-primary">
        <span>Fazer Simulação Gratuita</span>
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  .portfolio-hero {
    padding: 180px 60px 100px;
    text-align: center;
    background: radial-gradient(
      circle at center,
      rgba(201, 168, 76, 0.05) 0%,
      transparent 70%
    );
  }

  .portfolio-grid-section {
    padding: 0 60px 120px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .portfolio-cta {
    padding: 100px 60px;
    text-align: center;
    background: #0d0d0d;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .portfolio-cta-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .cta-title {
    font-family: "Bebas Neue", sans-serif;
    font-size: 3.5rem;
    margin-bottom: 20px;
  }

  .cta-title span {
    color: var(--gold, #c9a84c);
  }

  .cta-desc {
    font-size: 1.2rem;
    color: #9e9e8e;
    margin-bottom: 40px;
  }
</style>
